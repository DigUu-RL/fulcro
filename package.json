{
	"name": "fulcro",
	"version": "0.0.0",
	"description": "Development root for the @fulcro packages.",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "npm run build --workspaces",
		"typecheck": "npm run typecheck --workspaces && tsc --noEmit -p tsconfig.tests.json",
		"test": "npm run build && vitest run --configLoader native",
		"test:watch": "npm run build && vitest --configLoader native",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"changeset": "changeset",
		"version-packages": "changeset version && npm install --package-lock-only",
		"release": "npm run build && changeset publish"
	},
	"author": "diguu <rodrigogeribola@hotmail.com>",
	"license": "ISC",
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@types/node": "^26.5.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"prettier": "^3.9.6",
		"tsc-alias": "^1.9.5",
		"typescript": "^5.3.3",
		"vitest": "^5.0.0"
	},
	"engines": {
		"node": ">=22"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DigUu-RL/fulcro.git"
	},
	"homepage": "https://github.com/DigUu-RL/fulcro#readme",
	"bugs": {
		"url": "https://github.com/DigUu-RL/fulcro/issues"
	}
}
