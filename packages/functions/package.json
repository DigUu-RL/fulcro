{
	"name": "@fulcro/functions",
	"version": "2.1.0",
	"description": "Runtime helpers turning control flow into values: an exhaustive switchFor, a throwing-free tryCatch, and Result and Option handled exhaustively.",
	"keywords": [
		"switch",
		"exhaustive",
		"enum",
		"result",
		"option",
		"try-catch",
		"typescript"
	],
	"license": "ISC",
	"author": "diguu <rodrigogeribola@hotmail.com>",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"dependencies": {
		"@fulcro/errors": "^2.0.0"
	},
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DigUu-RL/fulcro.git",
		"directory": "packages/functions"
	},
	"homepage": "https://github.com/DigUu-RL/fulcro/tree/main/packages/functions#readme",
	"bugs": {
		"url": "https://github.com/DigUu-RL/fulcro/issues"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node ../../tools/build/rewrite-aliases.mjs",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"prepublishOnly": "npm run build"
	}
}
