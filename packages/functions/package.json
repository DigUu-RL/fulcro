{
	"name": "@fulcro/functions",
	"version": "3.1.1",
	"description": "Runtime helpers turning control flow into values: an exhaustive switchFor, a throwing-free tryCatch, Result and Option handled exhaustively, and equals, a comparison by contents with rules of your own.",
	"type": "module",
	"keywords": [
		"switch",
		"exhaustive",
		"enum",
		"result",
		"option",
		"try-catch",
		"equality",
		"deep-equal",
		"typescript"
	],
	"license": "ISC",
	"author": "diguu <rodrigogeribola@hotmail.com>",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src",
		"!src/tests"
	],
	"sideEffects": false,
	"dependencies": {
		"@fulcro/errors": "^3.1.0"
	},
	"peerDependencies": {
		"typescript": ">=5.4"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=22.12"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DigUu-RL/fulcro.git",
		"directory": "packages/functions"
	},
	"homepage": "https://github.com/DigUu-RL/fulcro/tree/main/packages/functions#readme",
	"bugs": {
		"url": "https://github.com/DigUu-RL/fulcro/issues"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc -p tsconfig.json",
		"prepublishOnly": "npm run build"
	}
}
