{
	"name": "@fulcro/reflect",
	"version": "2.1.0",
	"description": "Type aware nameOf, typeOf and defaultOf, with the compile time transformer that resolves them in the box.",
	"type": "module",
	"keywords": [
		"nameof",
		"typeof",
		"default",
		"reflection",
		"typescript"
	],
	"license": "ISC",
	"author": "diguu <rodrigogeribola@hotmail.com>",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./transformer": {
			"types": "./dist/transformer/index.d.ts",
			"default": "./dist/transformer/index.js"
		},
		"./unplugin": {
			"types": "./dist/unplugin/index.d.ts",
			"default": "./dist/unplugin/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src",
		"!src/tests"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc -p tsconfig.json",
		"prepublishOnly": "npm run build"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22.12"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DigUu-RL/fulcro.git",
		"directory": "packages/reflect"
	},
	"homepage": "https://github.com/DigUu-RL/fulcro/tree/main/packages/reflect#readme",
	"bugs": {
		"url": "https://github.com/DigUu-RL/fulcro/issues"
	},
	"dependencies": {
		"@fulcro/errors": "^3.0.0",
		"@fulcro/transform-core": "^2.1.0"
	},
	"peerDependencies": {
		"typescript": ">=5.9 <7"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	}
}
