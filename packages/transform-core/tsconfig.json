{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		// No DOM, unlike the shared base: nothing here calls a browser API, and the DOM
		// declarations made every program the transformers build over two times slower.
		"lib": ["ES2024"],
		"types": ["node"],
		"paths": {
			"@/*": ["./*"]
		}
	},
	"include": ["src", "tsdown.config.ts"]
}
