{
	"name": "@fulcro/parallel",
	"version": "1.3.0",
	"description": "Structured tasks with cancellation for work that waits, and a worker pool for CPU-bound work, on the browser and on Node.",
	"keywords": [
		"worker",
		"worker-threads",
		"web-worker",
		"parallel",
		"pool",
		"cancellation",
		"structured-concurrency",
		"typescript"
	],
	"license": "ISC",
	"author": "diguu <rodrigogeribola@hotmail.com>",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"browser": "./dist/browser.js",
			"default": "./dist/index.js"
		},
		"./worker": "./dist/worker/entry.js",
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"dependencies": {
		"@fulcro/errors": "^2.2.0",
		"@fulcro/functions": "^2.1.0"
	},
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DigUu-RL/fulcro.git",
		"directory": "packages/parallel"
	},
	"homepage": "https://github.com/DigUu-RL/fulcro/tree/main/packages/parallel#readme",
	"bugs": {
		"url": "https://github.com/DigUu-RL/fulcro/issues"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node ../../tools/build/rewrite-aliases.mjs",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"prepublishOnly": "npm run build"
	}
}
