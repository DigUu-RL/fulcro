{
	"name": "@fulcro/memory",
	"version": "0.1.0",
	"description": "Where a value's bytes live and who may reach them: storage, allocation and access to memory regions.",
	"keywords": [
		"memory",
		"storage",
		"allocator",
		"buffer",
		"typescript"
	],
	"license": "ISC",
	"author": "diguu <rodrigogeribola@hotmail.com>",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./transformer": {
			"types": "./dist/transformer/index.d.ts",
			"default": "./dist/transformer/index.js"
		},
		"./unplugin": {
			"types": "./dist/unplugin/index.d.mts",
			"default": "./dist/unplugin/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"dependencies": {
		"@fulcro/errors": "^2.0.0",
		"@fulcro/transform-core": "^1.3.0"
	},
	"devDependencies": {
		"@fulcro/types": "^1.3.0"
	},
	"peerDependencies": {
		"typescript": ">=5.3.3 <7"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DigUu-RL/fulcro.git",
		"directory": "packages/memory"
	},
	"homepage": "https://github.com/DigUu-RL/fulcro/tree/main/packages/memory#readme",
	"bugs": {
		"url": "https://github.com/DigUu-RL/fulcro/issues"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node ../../tools/build/rewrite-aliases.mjs",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"prepublishOnly": "npm run build"
	}
}
